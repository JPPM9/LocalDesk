{
  "name": "localdesk",
  "productName": "LocalDesk",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-App für lokale KI-Modelle über Ollama",
  "keywords": [],
  "license": "MIT",
  "author": "JPPM9",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "electron-forge package && electron-builder --win --prepackaged out/LocalDesk-win32-x64 --publish never",
    "release": "node scripts/release.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "9.0.0",
    "electron-updater": "6.8.10",
    "fflate": "^0.8.3",
    "i18next": "^26.5.11",
    "lucide-react": "^1.61.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  }
}
